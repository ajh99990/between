{
  "name": "@between/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Between scoped MCP tools and trusted standalone stdio launcher",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trusted-stdio": "./dist/trusted-stdio.js",
    "./trusted-host": {
      "types": "./dist/trusted-host.d.ts",
      "import": "./dist/trusted-host.js"
    }
  },
  "bin": {
    "between-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "publish"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pack": "node scripts/test-package.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@between/contracts": "workspace:*",
    "@between/core": "workspace:*",
    "@modelcontextprotocol/server": "2.3.0",
    "better-sqlite3": "13.0.3",
    "xstate": "5.33.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@types/node": "22.19.3",
    "@modelcontextprotocol/client": "2.3.0"
  }
}
