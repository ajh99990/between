{
  "name": "between-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Between 管理控制台，基于完整 Ant Design Pro 6",
  "repository": "https://github.com/ajh99990/between",
  "scripts": {
    "dev": "cross-env MOCK=none max dev --host 127.0.0.1 --port 8888",
    "build": "max build",
    "setup": "max setup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src config",
    "lint:antd": "antd lint ./src --format json",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.14-2",
