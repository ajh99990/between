{
  "name": "between-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Between 管理控制台，基于完整 Ant Design Pro 6",
  "repository": "https://github.com/ajh99990/between",
  "scripts": {
    "dev": "node scripts/prepare-pro.mjs && cross-env MOCK=none max dev --host 127.0.0.1 --port 8888",
    "build": "node scripts/prepare-pro.mjs && max build",
    "setup": "node scripts/prepare-pro.mjs && max setup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src config",
    "test": "vitest run tests/config.test.ts && node tests/static.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "antd": "^6.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@ant-design/cssinjs": "2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.7.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "@playwright/test": "1.61.1"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0",
      "@ant-design/icons": "$@ant-design/icons"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
    },
    "@utoo/pack": {
      "send": "^0.19.0"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=24"
  }
}
