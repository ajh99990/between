    "@ant-design/x-markdown": "^2.9.0",
    "@ant-design/x-sdk": "^2.9.0",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^6.6.0",
    "antd-style": "^4.1.0",
    "china-division": "^2.7.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.21",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.0",
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@umijs/lint": "^4.7.3",
    "@umijs/max": "^4.7.3",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "@umijs/request-record": "^1.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "geojson": "^0.5.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mockjs": "^1.1.0",
    "react-doctor": "^0.9.11",
    "swagger-ui-dist": "^5.32.8",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
