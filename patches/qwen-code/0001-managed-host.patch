+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+export interface ProviderResponseProvenance {
+  readonly provider_attempt_id: string;
+  readonly response_id?: string;
+}
+
+// This is object-bound provenance, never a latest-response lookup. Provider
+// payload fields cannot forge entries in this in-process association.
+const provenance = new WeakMap<object, ProviderResponseProvenance>();
+
+export function setProviderResponseProvenance<T extends object>(
+  response: T,
+  value: ProviderResponseProvenance | undefined,
+): T {
+  if (value) provenance.set(response, Object.freeze({ ...value }));
+  return response;
+}
+
+export function getProviderResponseProvenance(
+  response: object,
+): ProviderResponseProvenance | undefined {
+  return provenance.get(response);
+}
