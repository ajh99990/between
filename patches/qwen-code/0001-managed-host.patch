+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { StructuredToolError, ToolErrorType } from './tool-error.js';
+
+export interface StrictToolPolicy {
+  isToolAllowed(name: string): boolean;
+}
+
+export function createStrictToolPolicy(
+  names: readonly string[] | undefined,
+): StrictToolPolicy {
+  // The Set stays inside the closure: freezing a Set does not freeze its entries.
+  const allowed = new Set(Array.isArray(names) ? names : []);
+  return Object.freeze({
+    isToolAllowed: (name: string): boolean => allowed.has(name),
+  });
+}
+
+export function strictToolDenialMessage(name: string): string {
+  return `Tool "${name}" is not permitted by this session's strict tool policy.`;
+}
+
+export function assertStrictToolAllowed(
+  policy: StrictToolPolicy,
+  name: string,
+): void {
+  if (!policy.isToolAllowed(name)) {
+    throw new StructuredToolError(
+      strictToolDenialMessage(name),
+      ToolErrorType.EXECUTION_DENIED,
+    );
+  }
+}
