+/** @license SPDX-License-Identifier: Apache-2.0 */
+import {
+  mkdirSync,
+  readFileSync,
+  writeFileSync,
+  renameSync,
+  rmSync,
+  lstatSync,
+} from 'node:fs';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+export function snapshotSessionTools(value: unknown): readonly string[] {
+  if (
+    !Array.isArray(value) ||
+    value.some(
+      (name) => typeof name !== 'string' || !/^[A-Za-z0-9_.:-]+$/.test(name),
+    )
+  ) {
+    throw new Error(
+      'sessionToolAllowlist must be an explicit array of exact tool names',
+    );
+  }
+  return Object.freeze([...new Set(value as string[])].sort());
+}
+
+export function intersectSessionTools(
+  parent: readonly string[],
+  child?: readonly string[],
+): readonly string[] {
+  const base = snapshotSessionTools(parent);
+  if (child === undefined) return base;
+  const requested = new Set(snapshotSessionTools(child));
+  return Object.freeze(base.filter((name) => requested.has(name)));
+}
+
+/** The directory must be host-owned, outside model-writable roots. */
+export function persistSessionTools(
+  projectDir: string,
+  sessionId: string,
+  current: readonly string[],
+  sourceSessionId?: string,
+): readonly string[] {
+  const validId = (id: string) => {
+    if (!/^[a-zA-Z0-9_-]+$/.test(id))
+      throw new Error('Invalid session policy id');
+    return id;
+  };
+  const directory = join(projectDir, 'host-tool-policies');
+  mkdirSync(directory, { recursive: true, mode: 0o700 });
+  if (lstatSync(directory).isSymbolicLink())
+    throw new Error('Session policy directory cannot be a symlink');
+  const filename = (id: string) => join(directory, `${validId(id)}.json`);
+  const read = (id: string): readonly string[] => {
+    const file = filename(id);
+    if (lstatSync(file).isSymbolicLink())
+      throw new Error('Session policy cannot be a symlink');
+    const record = JSON.parse(readFileSync(file, 'utf8')) as {
+      schema_version: number;
+      tools: unknown;
+    };
+    if (record.schema_version !== 1)
+      throw new Error('Unsupported session policy version');
+    return snapshotSessionTools(record.tools);
+  };
+  const lock = `${filename(sessionId)}.lock`;
+  mkdirSync(lock, { mode: 0o700 });
+  const temporary = `${filename(sessionId)}.${randomUUID()}.tmp`;
+  try {
+    let effective = snapshotSessionTools(current);
+    if (sourceSessionId)
+      effective = intersectSessionTools(read(sourceSessionId), effective);
+    try {
+      effective = intersectSessionTools(read(sessionId), effective);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+    }
+    writeFileSync(
+      temporary,
+      JSON.stringify({ schema_version: 1, tools: effective }),
+      { mode: 0o600, flag: 'wx' },
+    );
+    renameSync(temporary, filename(sessionId));
+    return effective;
+  } finally {
+    rmSync(temporary, { force: true });
+    rmSync(lock, { recursive: true });
+  }
+}
