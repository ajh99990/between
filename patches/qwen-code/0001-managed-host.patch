+import { PassThrough } from 'node:stream';
+import { FinishReason } from '@google/genai';
+import { describe, expect, it } from 'vitest';
+import { LlmEventType } from '@qwen-code/qwen-code-core/core/turn.js';
+import type { Config } from '@qwen-code/qwen-code-core/config/config.js';
+import { StreamJsonOutputAdapter } from './StreamJsonOutputAdapter.js';
+import type {
+  CLIMessage,
+  CLIResultMessageSuccess,
+  CLIAssistantMessage,
+} from '../types.js';
+
+function setup(session = 'main-session') {
+  const output = new PassThrough();
+  let text = '';
+  output.on('data', (chunk) => {
+    text += String(chunk);
+  });
+  const config = {
+    getSessionId: () => session,
+    getModel: () => 'synthetic-model',
+  } as unknown as Config;
+  const adapter = new StreamJsonOutputAdapter(config, false, output);
+  const messages = () =>
+    text
+      .trim()
+      .split('\n')
+      .filter(Boolean)
+      .map((line) => JSON.parse(line) as CLIMessage);
+  return {
+    adapter,
+    messages,
+    result: () =>
+      messages().findLast(
+        (message) => message.type === 'result',
+      ) as CLIResultMessageSuccess,
+  };
+}
+function content(
+  adapter: StreamJsonOutputAdapter,
+  text: string,
+  attempt: string,
+) {
+  adapter.processEvent({
+    type: LlmEventType.Content,
+    value: text,
+    providerAttemptId: attempt,
+  });
+}
+function finish(adapter: StreamJsonOutputAdapter, attempt?: string) {
+  adapter.processEvent({
+    type: LlmEventType.Finished,
+    value: {
+      reason: FinishReason.STOP,
+      usageMetadata: undefined,
+      ...(attempt
+        ? { providerAttemptId: attempt, responseId: `response-${attempt}` }
+        : {}),
+    },
+  });
+  adapter.finalizeAssistantMessage();
+}
+const options = {
+  isError: false,
+  durationMs: 1,
+  apiDurationMs: 1,
+  numTurns: 1,
+};
+describe('result object-bound provider correlation', () => {
+  it('uses the actual main result-source message despite interleaved subagent messages', () => {
+    const run = setup();
+    run.adapter.startAssistantMessage();
+    content(run.adapter, 'main answer', 'main-attempt');
+    finish(run.adapter, 'main-attempt');
+    const main = run
+      .messages()
+      .find((message) => message.type === 'assistant') as CLIAssistantMessage;
+    run.adapter.emitMessage({
+      ...main,
+      uuid: 'subagent-message',
+      parent_tool_use_id: 'subagent-tool',
+      provider_attempt_id: 'subagent-attempt',
+      message: {
+        ...main.message,
+        content: [{ type: 'text', text: 'subagent answer' }],
+      },
+    });
+    run.adapter.emitResult(options);
+    expect(run.result()).toMatchObject({
+      result: 'main answer',
+      provider_attempt_id: 'main-attempt',
+      response_id: 'response-main-attempt',
+      provider_attempt_ids: ['main-attempt'],
+    });
+  });
+  it('retracts fresh retry/fallback provenance and keeps only actual replacement text', () => {
+    const run = setup();
+    run.adapter.startAssistantMessage();
+    content(run.adapter, 'discarded', 'failed-attempt');
+    run.adapter.restartAttempt(false, []);
+    content(run.adapter, 'replacement', 'final-attempt');
+    finish(run.adapter, 'final-attempt');
+    run.adapter.emitResult(options);
+    expect(run.result()).toMatchObject({
+      result: 'replacement',
+      provider_attempt_id: 'final-attempt',
+      provider_attempt_ids: ['final-attempt'],
+    });
+  });
+  it('retains continuation contributors but chooses the exact terminal attempt', () => {
+    const run = setup();
+    run.adapter.startAssistantMessage();
+    content(run.adapter, 'part one ', 'first-attempt');
+    run.adapter.restartAttempt(true, []);
+    content(run.adapter, 'part two', 'closing-attempt');
+    finish(run.adapter, 'closing-attempt');
+    run.adapter.emitResult(options);
+    expect(run.result()).toMatchObject({
+      result: 'part one part two',
+      provider_attempt_id: 'closing-attempt',
+      provider_attempt_ids: ['first-attempt', 'closing-attempt'],
+    });
+  });
+  it('does not claim terminal correlation for cancelled or untagged synthetic completion', () => {
+    const run = setup();
+    run.adapter.startAssistantMessage();
+    content(run.adapter, 'partial', 'partial-attempt');
+    finish(run.adapter);
+    run.adapter.emitResult(options);
+    expect(run.result()).not.toHaveProperty('provider_attempt_id');
+    run.adapter.emitResult({
+      ...options,
+      isError: true,
+      errorMessage: 'cancelled',
+    });
+    expect(run.result()).not.toHaveProperty('provider_attempt_id');
+  });
+  it('never reuses terminal correlation from an earlier empty-message turn', () => {
+    const run = setup();
+    run.adapter.startAssistantMessage();
+    content(run.adapter, 'earlier answer', 'earlier-attempt');
+    finish(run.adapter, 'earlier-attempt');
+    run.adapter.emitResult(options);
+    run.adapter.startAssistantMessage();
+    finish(run.adapter);
+    run.adapter.emitResult(options);
+    expect(run.result()).not.toHaveProperty('provider_attempt_id');
+  });
+
+  it.each([{ structuredResult: { answer: 4 } }, { summary: 'host summary' }])(
+    'does not label host-derived result as model output',
+    (override) => {
+      const run = setup();
+      run.adapter.startAssistantMessage();
+      content(run.adapter, 'model text', 'model-attempt');
+      finish(run.adapter, 'model-attempt');
+      run.adapter.emitResult({ ...options, ...override });
+      expect(run.result()).not.toHaveProperty('provider_attempt_id');
+    },
+  );
+  it('keeps simultaneous adapter instances isolated', () => {
+    const left = setup('left');
+    const right = setup('right');
+    left.adapter.startAssistantMessage();
+    right.adapter.startAssistantMessage();
+    content(left.adapter, 'L', 'left-attempt');
+    content(right.adapter, 'R', 'right-attempt');
+    finish(right.adapter, 'right-attempt');
+    finish(left.adapter, 'left-attempt');
+    right.adapter.emitResult(options);
+    left.adapter.emitResult(options);
+    expect(left.result()).toMatchObject({
+      session_id: 'left',
+      provider_attempt_id: 'left-attempt',
+      result: 'L',
+    });
+    expect(right.result()).toMatchObject({
+      session_id: 'right',
+      provider_attempt_id: 'right-attempt',
+      result: 'R',
+    });
+  });
+});
