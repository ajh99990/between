+import { describe, expect, it, vi } from 'vitest';
+import {
+  PermissionManager,
+  type PermissionManagerConfig,
+} from './permission-manager.js';
+import { strictToolDenialMessage } from '../tools/strict-tool-policy.js';
+
+vi.mock('../utils/debugLogger.js', () => ({
+  createDebugLogger: () => ({
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+  }),
+}));
+vi.mock('../utils/shellAstParser.js', () => ({
+  isShellCommandReadOnlyAST: vi.fn(),
+  isShellCommandReadOnlyASTInDirectory: vi.fn(),
+}));
+vi.mock('../utils/shell-utils.js', () => ({
+  getShellConfiguration: () => ({ shell: 'bash' }),
+  normalizeMonitorCommand: vi.fn(),
+}));
+
+function manager(
+  names?: string[],
+  overrides: Partial<PermissionManagerConfig> = {},
+) {
+  const cfg = {
+    getSessionToolAllowlist: () => names,
+    getPermissionsAllow: () => ['Bash', 'Read', 'mcp__*'],
+    getPermissionsAsk: () => [],
+    getPermissionsDeny: () => [],
+    getCoreTools: () => [],
+    getEagerTools: () => [],
+    getApprovalMode: () => 'yolo',
+    ...overrides,
+  } as PermissionManagerConfig;
+  const pm = new PermissionManager(cfg);
+  pm.initialize();
+  return { pm, cfg };
+}
+
+describe('strict policy overrides permission, eager and approval settings', () => {
+  it.each([{ names: undefined }, { names: [] }])(
+    'fails closed regardless of broad auto-approval %j',
+    async ({ names }) => {
+      const { pm } = manager(names);
+      for (const toolName of [
+        'read_file',
+        'run_shell_command',
+        'exec',
+        'tool_call',
+        'agent',
+        'skill',
+        'mcp__demo__echo',
+        'future_tool',
+      ]) {
+        expect(await pm.evaluate({ toolName })).toBe('deny');
+        expect(await pm.isToolEnabled(toolName)).toBe(false);
+        expect(await pm.getToolRegistrationStatus(toolName)).toBe('disabled');
+        expect(pm.hasRelevantRules({ toolName })).toBe(true);
+        expect(pm.findMatchingDenyRule({ toolName })).toBe(
+          strictToolDenialMessage(toolName),
+        );
+      }
+    },
+  );
+  it('uses exact names before legacy normalization and category expansion', async () => {
+    const { pm } = manager(['read_file', 'mcp__demo__echo']);
+    expect(await pm.evaluate({ toolName: 'read_file' })).toBe('allow');
+    expect(await pm.isToolEnabled('read_file')).toBe(true);
+    for (const toolName of [
+      'Read',
+      'READ_FILE',
+      'grep_search',
+      'mcp__other__echo',
+    ]) {
+      expect(await pm.evaluate({ toolName })).toBe('deny');
+      expect(await pm.getToolRegistrationStatus(toolName)).toBe('disabled');
+    }
+  });
+  it('keeps ordinary deny rules restrictive for allowed strict names', async () => {
+    const { pm } = manager(['read_file'], {
