+/** @license SPDX-License-Identifier: Apache-2.0 */
+import type { Config } from '@qwen-code/qwen-code-core/config/config.js';
+
+export function readManagedHostPolicy(config: Config) {
+  const hooks = config.getHookSystem();
+  const registrations = hooks
+    ?.getSessionHooksManager()
+    .getAllSessionHooks(config.getSessionId());
+  return {
+    schema_version: 1 as const,
+    managed_host_contract_version: 1 as const,
+    source: 'runtime_config' as const,
+    session_id: config.getSessionId(),
+    effective_session_tool_allowlist: [...config.getSessionToolAllowlist()],
+    registered_tools: config.getToolRegistry().getAllToolNames().sort(),
+    hooks_status: hooks ? ('present' as const) : ('unavailable' as const),
+    unmanaged_hooks_blocked: config.getHostManagedHooksOnly(),
+    sdk_hooks:
+      registrations
+        ?.filter(
+          (entry) =>
+            entry.config.type === 'function' &&
+            entry.config.name?.startsWith('sdk:'),
+        )
+        .map((entry) => ({
+          event: entry.eventName,
+          matcher: entry.matcher,
+          name: entry.config.name,
+          timeout_ms: entry.config.timeout,
+        })) ?? [],
+  };
+}
