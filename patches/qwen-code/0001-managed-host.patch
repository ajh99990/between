+export function createProviderContentStore(
+  projectDir: string,
+): NonNullable<ProviderAttemptOptions['storeOversize']> {
+  const directory = join(projectDir, 'provider-content');
+  const ttl = 24 * 60 * 60 * 1000;
+  const budget = 100 * 1024 * 1024;
+  return ({ content, bytes }) => {
+    if (bytes !== Buffer.byteLength(content, 'utf8') || bytes > budget)
+      return undefined;
+    mkdirSync(directory, { recursive: true, mode: 0o700 });
+    if (lstatSync(directory).isSymbolicLink())
+      throw new Error('Unsafe content directory');
+    let used = 0;
+    const now = Date.now();
+    for (const name of readdirSync(directory)) {
+      if (!/^[a-f0-9-]{36}\.json$/.test(name)) continue;
+      const file = join(directory, name);
+      const stat = lstatSync(file);
+      if (!stat.isFile() || stat.isSymbolicLink()) continue;
+      if (now - stat.mtimeMs > ttl) unlinkSync(file);
+      else used += stat.size;
+    }
+    if (used + bytes > budget) return undefined;
+    const id = randomUUID();
+    writeFileSync(join(directory, `${id}.json`), content, {
+      encoding: 'utf8',
+      mode: 0o600,
+      flag: 'wx',
+    });
+    return {
+      id: `qwen-content:${id}`,
+      expires_at: new Date(now + ttl).toISOString(),
+    };
+  };
+}
