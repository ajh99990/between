{
  "name": "between",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 SillyTavern 角色引擎的本机聊天应用与管理控制台",
  "license": "AGPL-3.0",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/admin",
    "apps/server",
    "packages/role-engine"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @between/admin",
    "setup": "npm run setup --workspace @between/admin",
    "build": "npm run build --workspace @between/admin",
    "typecheck": "npm run setup && npm run typecheck --workspace @between/admin && node scripts/check-modules.mjs",
    "lint": "npm run lint --workspace @between/admin",
    "test": "npm run test --workspace @between/role-engine && npm run test --workspace @between/server && npm run test:plan --workspace @between/server && npm run test:local --workspace @between/server && npm run test --workspace @between/admin && npm run test:smoke",
    "test:engine": "npm run test --workspace @between/role-engine",
    "test:app": "npm run test --workspace @between/server",
    "test:plan": "npm run test:plan --workspace @between/server",
    "test:local": "npm run test:local --workspace @between/server",
    "test:browser": "npm run test:browser --workspace @between/admin && node tests/browser/chat.mjs && node tests/browser/oauth.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "start": "node apps/server/server.mjs",
    "start:demo": "node apps/server/server.mjs --demo",
    "start:local": "node apps/server/local-start.mjs",
    "preview": "node apps/admin/tests/preview.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "acorn": "8.16.0"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "^3.1.14-2",
      "axios": "^1.19.0",
      "@ant-design/icons": "^6.3.2"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
    },
    "@utoo/pack": {
      "send": "^0.19.0"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23"
  }
}
