{
  "name": "between",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r --sort run build && node scripts/build-integration.mjs",
    "typecheck": "pnpm -r --sort run typecheck && tsc -p tests/integration/tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "start": "pnpm --filter @between/desktop start",
    "skills:check": "node scripts/skills.mjs validate --source skills/relationship",
    "skills:pack": "node scripts/skills.mjs pack --source skills/relationship --out artifacts/skills",
    "test:skills": "node --test tests/packaging/skills*.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:release": "node scripts/run-tests.mjs --release",
    "pack:desktop": "node scripts/package-desktop.mjs",
    "native:check": "node scripts/check-native.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.3",
    "@types/better-sqlite3": "7.6.13",
    "esbuild": "0.25.12",
    "@modelcontextprotocol/client": "2.3.0",
    "@between/contracts": "workspace:*",
    "@between/core": "workspace:*",
    "@between/host-qwen": "workspace:*",
    "better-sqlite3": "13.0.3",
    "@between/desktop": "workspace:*",
    "crc-32": "1.2.2"
  }
}
