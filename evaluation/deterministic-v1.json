      "input": {
        "capture_status": "present",
        "value": "[bad json"
      },
      "system": {
        "capture_status": "disabled"
      },
      "output": {
        "capture_status": "disabled"
      },
      "policy": {
        "captureContent": true
      },
      "expected": {
        "qwen.input.compatibility": "unavailable"
      },
      "absent": [
        "gen_ai.input.messages"
      ]
    },
    {
