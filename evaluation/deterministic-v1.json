        "value": "汉字"
      },
      "policy": {
        "captureContent": true,
        "maxBytes": 7
      },
      "expected": {
        "capture_status": "oversize",
        "bytes": 8
      },
      "forbidden": [],
      "absent": [
        "value",
        "content_ref"
      ]
    },
    {
      "id": "unicode-byte-boundary",
      "requirement": "R2.2/R2.4",
      "kind": "capture",
      "field": {
        "capture_status": "present",
        "value": "汉字"
      },
      "policy": {
        "captureContent": true,
        "maxBytes": 8
      },
      "expected": {
        "capture_status": "present",
        "bytes": 8
