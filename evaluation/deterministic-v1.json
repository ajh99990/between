      "forbidden": []
    },
    {
      "id": "system-only-preserved",
      "requirement": "R2.2",
      "kind": "attempt",
      "input": {
        "capture_status": "oversize",
        "reason": "byte_limit"
      },
      "system": {
        "capture_status": "present",
        "value": [
          {
            "type": "text",
            "content": "SYNTHETIC SYSTEM"
          }
        ]
      },
      "output": {
        "capture_status": "disabled"
      },
      "policy": {
        "captureContent": true
      },
      "expected": {
        "qwen.capture.input.status": "oversize",
        "qwen.input.compatibility": "system-prepended-v1",
        "gen_ai.input.messages": "[{\"role\":\"system\",\"parts\":[{\"type\":\"text\",\"content\":\"SYNTHETIC SYSTEM\"}]}]",
        "qwen.correlation.status": "unmatched"
      },
      "absent": [
        "langfuse.observation.output"
      ]
    },
    {
      "id": "malformed-input-explicit",
      "requirement": "R2.2",
