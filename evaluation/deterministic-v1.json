{
  "schema_version": 1,
  "synthetic": true,
  "layer": "deterministic-contract",
  "cases": [
    {
      "id": "explicit-memory-off",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "关闭长期记忆",
      "expected": {
        "memory": "off"
      }
    },
    {
      "id": "explicit-memory-on",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "开启长期记忆",
      "expected": {
        "memory": "on"
      }
    },
    {
      "id": "quote-not-consent",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "“开启长期记忆”是什么意思",
      "expected": {}
