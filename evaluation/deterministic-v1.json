      "kind": "controls",
      "text": "叫我夜猫子但只做朋友",
      "expected": {
        "nickname": "夜猫子",
        "nicknameState": "allowed",
        "direction": "friends"
      }
    },
    {
      "id": "pause-role",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "暂停角色扮演",
      "expected": {
