    {
      "id": "question-not-consent",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "开启长期记忆？",
      "expected": {}
    },
    {
      "id": "negated-not-consent",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "不要开启长期记忆",
      "expected": {}
    },
    {
