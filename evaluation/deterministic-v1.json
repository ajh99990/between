        "role": "active"
      }
    },
    {
      "id": "revoke-name",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "别这样叫我了",
      "expected": {
        "nicknameState": "suspended"
      }
    },
    {
      "id": "ordinary-not-consent",
      "requirement": "CTRL-01/03; REL-03/04",
      "kind": "controls",
      "text": "SYNTHETIC 今天很开心",
      "expected": {}
    },
    {
      "id": "capture-disabled",
