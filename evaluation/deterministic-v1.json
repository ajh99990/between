      "kind": "capture",
      "field": {
        "capture_status": "present",
        "value": "SYNTHETIC_CANARY"
      },
      "policy": {
        "captureContent": false
      },
      "expected": {
        "capture_status": "disabled",
        "reason": "export_content_disabled"
      },
      "forbidden": [
        "SYNTHETIC_CANARY"
      ],
      "absent": [
        "value",
        "content_ref"
      ]
    },
    {
      "id": "credential-redacted",
      "requirement": "R2.2/R2.4",
      "kind": "capture",
      "field": {
        "capture_status": "present",
        "value": {
          "password": "SYNTHETIC_CANARY"
        }
      },
      "policy": {
        "captureContent": true
      },
      "expected": {
        "capture_status": "redacted"
      },
      "forbidden": [
        "SYNTHETIC_CANARY"
      ]
    },
    {
      "id": "known-canary-redacted",
      "requirement": "R2.2/R2.4",
      "kind": "capture",
      "field": {
        "capture_status": "present",
        "value": "body SYNTHETIC_CANARY"
      },
      "policy": {
        "captureContent": true,
        "redactValues": [
