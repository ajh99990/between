      "requirement": "R2.4",
      "kind": "attempt",
      "input": {
        "capture_status": "present",
        "value": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "content": "SYNTHETIC_CANARY"
              }
            ]
          }
        ]
      },
      "system": {
        "capture_status": "disabled"
      },
      "output": {
        "capture_status": "disabled"
      },
      "policy": {
        "captureContent": false
      },
      "expected": {
        "qwen.capture.input.status": "disabled",
        "qwen.capture.input.source_status": "present"
