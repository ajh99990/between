{
  "name": "@between/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Between 通用深色玻璃管理员后台",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8888",
    "build": "node scripts/verify-assets.mjs && vite build",
    "setup": "node scripts/verify-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src vite.config.ts",
    "test": "vitest run && node tests/static.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
